// Matte OS base niri config.
//
// This file ships with the image and is replaced on every update, so don't edit it.
// /etc/niri/config.kdl includes it and adds this PC's monitors.
// To customise niri for your account, create ~/.config/niri/config.kdl with
//     include "/etc/niri/config.kdl"
// at the top, followed by your own settings (later settings win).
// Check any config with: niri validate -c <file>
//
// Docs: https://github.com/niri-wm/niri/wiki

input {
    keyboard {
        xkb {
            // Left empty so niri follows the keyboard layout chosen during install.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // The sky-blue accent marks the focused window, and nothing else.
    focus-ring {
        width 2
        active-color "#7DD3FC"
        inactive-color "#2A2F3A"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=8
        color "#0009"
    }
}

overview {
    backdrop-color "#050608"
}

// Apps draw no title bars of their own; the focus ring does that job.
prefer-no-csd

// Stand-in shell until Matte OS's own shell is ready.
spawn-at-startup "dms" "run"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Rounded corners on every window, matching the dark glass look.
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Picture-in-picture video floats instead of tiling.
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Animated wallpapers (matte-wallpaper) stay still while you switch workspaces,
// and show behind the workspaces in the overview.
layer-rule {
    match namespace="^linux-wallpaperengine$"
    place-within-backdrop true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+T hotkey-overlay-title="Terminal: Kitty" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="Files: Dolphin" { spawn "dolphin"; }
    Mod+B hotkey-overlay-title="Browser: Zen" { spawn "flatpak" "run" "app.zen_browser.zen"; }

    // Shell (DankMaterialShell for now)
    Mod+Space hotkey-overlay-title="Search apps and files" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+L hotkey-overlay-title="Lock the screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Ctrl+Shift+Escape hotkey-overlay-title="Task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // Modes: Win+M steps through VFX, Game and Focus; Win+Shift+M goes back to normal
    Mod+M hotkey-overlay-title="Next mode (VFX, Game, Focus)" { spawn "matte-mode" "cycle"; }
    Mod+Shift+M hotkey-overlay-title="Normal mode" { spawn "matte-mode" "set" "normal"; }

    // Screenshots (Win+Shift+S works like Windows' Snipping Tool)
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Volume and media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }

    // Overview of all workspaces (Alt+Tab and Win+Tab switch windows, built into niri)
    Mod+O repeat=false { toggle-overview; }

    // Close windows
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Move focus along the strip of columns
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move windows and columns
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // Monitors
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Mouse wheel: Win+wheel changes workspace, Win+Shift+wheel scrolls the strip
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // Column layout
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+W { toggle-column-tabbed-display; }

    // Floating windows (Win+V is clipboard history, so floating moves to Win+Alt+V)
    Mod+Alt+V   { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
}

// Settings that DankMaterialShell writes from its own settings screens
// (its window rules, wallpaper blur, Alt+Tab look, cursor and any shortcuts you add there).
// They're optional, so niri doesn't mind if DMS hasn't written them yet.
// Window looks (gaps, corners, colours) stay with Matte OS, so DMS's layout file is left out.
include optional=true "~/.config/niri/dms/windowrules.kdl"
include optional=true "~/.config/niri/dms/wpblur.kdl"
include optional=true "~/.config/niri/dms/alttab.kdl"
include optional=true "~/.config/niri/dms/cursor.kdl"
include optional=true "~/.config/niri/dms/binds.kdl"
