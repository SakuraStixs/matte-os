// Matte OS default niri config.
//
// This file is used for every user who hasn't made their own config.
// To customise it, copy it to ~/.config/niri/config.kdl and edit that copy.
// Check it any time with: niri validate -c ~/.config/niri/config.kdl
//
// Docs: https://github.com/niri-wm/niri/wiki

input {
    keyboard {
        xkb {
            // Left empty so niri follows the keyboard layout chosen during install.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

// Qt apps (Dolphin and others) pick up the Matte OS colour scheme.
environment {
    QT_QPA_PLATFORMTHEME "kde"
}

// Monitors
// Your two 1920x1080 monitors run at 165 Hz, but report 60 Hz as their default.
// Leaving out the refresh rate makes niri pick the highest one for that resolution.
// Blocks for connectors that aren't plugged in are simply ignored.
// Run `niri msg outputs` to see your real connector names and positions.
output "DP-1" {
    mode "1920x1080"
}
output "DP-2" {
    mode "1920x1080"
}
output "DP-3" {
    mode "1920x1080"
}
output "HDMI-A-1" {
    mode "1920x1080"
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Matte OS is monochrome, like the wallpaper: near-black with off-white.
    // The off-white ring marks the focused window, and nothing else.
    focus-ring {
        width 2
        active-color "#F2F2F2"
        inactive-color "#2E2E2E"
    }

    // Same near-black as the wallpaper, so nothing flashes at login.
    background-color "#1F1F1F"

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=8
        color "#0009"
    }
}

// Apps draw no title bars of their own; the focus ring does that job.
prefer-no-csd

// Iris, Matte OS's own shell (Quickshell). Lives in /etc/xdg/quickshell/iris;
// a copy in ~/.config/quickshell/iris overrides it while you develop.
spawn-at-startup "qs" "-c" "iris"

// Shows the password box when an app needs administrator rights.
spawn-at-startup "/usr/libexec/matte-os/polkit-agent"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Rounded corners on every window, matching the dark glass look.
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Picture-in-picture video floats instead of tiling.
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+T hotkey-overlay-title="Terminal: Kitty" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="Files: Dolphin" { spawn "dolphin"; }
    Mod+B hotkey-overlay-title="Browser: Zen" { spawn "flatpak" "run" "app.zen_browser.zen"; }

    // Shell. Interim launcher until Iris has its own (command palette).
    Mod+Space hotkey-overlay-title="Search apps" { spawn "fuzzel"; }
    Mod+L hotkey-overlay-title="Lock the screen" { spawn "qs" "-c" "iris" "ipc" "call" "lock" "lock"; }
    // Coming in Iris: clipboard history, power menu, task manager.

    // Screenshots (Win+Shift+S works like Windows' Snipping Tool)
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Volume and media keys (straight to PipeWire until Iris shows its own volume popup)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "3%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "3%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }

    // Overview of all workspaces (Alt+Tab and Win+Tab switch windows, built into niri)
    Mod+O repeat=false { toggle-overview; }

    // Close windows
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Move focus along the strip of columns
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move windows and columns
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // Monitors
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Mouse wheel: Win+wheel changes workspace, Win+Shift+wheel scrolls the strip
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // Column layout
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+W { toggle-column-tabbed-display; }

    // Floating windows (Win+V is reserved for clipboard history later, so floating is on Win+Alt+V)
    Mod+Alt+V   { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
}
