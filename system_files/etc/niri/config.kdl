// niri config for this PC.
//
// Everything Matte OS sets up (looks, shortcuts, shell) lives in the base config below,
// which updates with the image. This file only holds what's specific to this machine.
//
// To customise niri for your account, create ~/.config/niri/config.kdl containing
//     include "/etc/niri/config.kdl"
// followed by your own settings, instead of editing this file.
// (If you do edit this file, image updates to it stop arriving on this PC.)
// Check it any time with: niri validate -c /etc/niri/config.kdl

include "/usr/share/matte-os/niri/config.kdl"

// Monitors: two 1920x1080 screens at 165 Hz, DP-4 on the left and DP-3 on the right.
// niri needs the exact rate from `niri msg outputs` (164.999 Hz on these screens).
// If a rate doesn't match exactly, niri falls back to the monitor's default (60 Hz).
output "DP-4" {
    mode "1920x1080@164.999"
    position x=0 y=0
}

output "DP-3" {
    mode "1920x1080@164.999"
    position x=1920 y=0
}
